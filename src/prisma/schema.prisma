// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  client
  doorman
  organizer
}

enum EventStatus {
  published
  canceled
  ongoing
  done
}

enum PurchaseStatus {
  eventConfirmation
  personalInfoSupplying
  payment
  done
  canceled
  expired
}

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  password  String
  name      String
  role      Role       @default(client)
  active    Boolean    @default(false)
  events    Event[]
  purchases Purchase[]

  @@map("users")
}

model Event {
  id             Int         @id @default(autoincrement())
  title          String
  description    String
  datetime       DateTime
  address        String
  address_title  String
  capacity       Int
  price_in_cents Int
  status         EventStatus @default(published)
  organizer      User        @relation(fields: [organizer_id], references: [id])
  organizer_id   Int
  metadata       Json
  purchases      Purchase[]
  tickets        Ticket[]

  @@map("events")
}

model Purchase {
  id         Int            @id @default(autoincrement())
  event      Event          @relation(fields: [event_id], references: [id])
  status     PurchaseStatus @default(eventConfirmation)
  client     User           @relation(fields: [client_id], references: [id])
  client_id  Int
  holder     String         @default("")
  document_number String    @default("")
  expires_at DateTime       @default(dbgenerated("NOW() + interval '20 minutes'"))
  event_id   Int
  tickets    Ticket[]

  @@map("purchases")
}

model Ticket {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  holder      String
  document_number String @default("")
  consumed    Boolean  @default(false)
  purchase    Purchase @relation(fields: [purchase_id], references: [id])
  purchase_id Int
  event       Event    @relation(fields: [event_id], references: [id])
  event_id    Int

  @@map("tickets")
}

model SearchResult {
  key        String   @unique
  result     String
  expires_at DateTime @default(dbgenerated("NOW() + interval '1 day'"))

  @@map("tmdb_search")
}
